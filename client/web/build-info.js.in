// Generated by CMake (src/CMakeLists.txt, configure_file) and linked with
// --pre-js ahead of client/web/startup.js. It records the choices that were
// made at configure time so the page can check them against the browser and
// tests can tell which flavour of the engine they loaded. The memory sizes
// are the very values passed to -sINITIAL_MEMORY and -sMAXIMUM_MEMORY.
Module["luantiBuild"] = {
	"type": "@CMAKE_BUILD_TYPE@",
	"simd": @WASM_BUILD_SIMD@,
	"lto": @WASM_BUILD_LTO@,
	"malloc": "@WASM_BUILD_MALLOC@",
	"initialMemory": @WASM_INITIAL_MEMORY@,
	"maximumMemory": @WASM_MAXIMUM_MEMORY@
};
